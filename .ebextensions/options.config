# AWS Elastic Beanstalk 설정
# Node.js 플랫폼의 nginx는 요청을 8080번 포트로 넘긴다. 서버(server.js)는 PORT 환경변수를 읽으니 여기서 8080으로 맞춘다.
# 로컬에서는 PORT가 없어서 그대로 3000번을 쓴다.
# API 키(GEMINI_API_KEY 등)와 GOOGLE_CLIENT_ID는 저장소에 넣지 말고 Beanstalk 콘솔의 "환경 속성"에서 넣는다.
option_settings:
  aws:elasticbeanstalk:application:environment:
    PORT: 8080
    NODE_ENV: production
