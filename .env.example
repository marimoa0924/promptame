# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git에 올라가지 않아요)
# cp .env.example .env

# Google AI Studio(https://aistudio.google.com/apikey)에서 발급한 키
GEMINI_API_KEY=

# 쓸 모델 이름. 비워 두면 gemini-3.5-flash-lite
GEMINI_MODEL=

# GPT(OpenAI)와 Claude(Anthropic)도 키를 넣으면 방을 만들 때 고를 수 있어요. 키가 있는 것만 선택할 수 있고, 둘 다 비워 두면 안 써요.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# 방에서 AI를 고르지 않았을 때 쓸 기본 AI (gemini, openai, anthropic). 비우면 키가 있는 것 중 앞에서부터
# DEFAULT_AI=

# 생각(thinking) 기능 예산. 기본 0(끔). 이 설정을 받지 않는 모델이면 빈 값으로 두면 안 보내요
# GEMINI_THINKING_BUDGET=0

# 랭킹과 본 문제 기록을 저장할 파일 (기본 ./store.json)
# DATA_FILE=./store.json

# 구글 로그인: 구글 클라우드 콘솔에서 만든 웹 애플리케이션 OAuth 클라이언트 ID. 비워 두면 게스트 로그인만 써요.
# GOOGLE_CLIENT_ID=
# 또는 구글 콘솔에서 내려받은 JSON 파일을 프로젝트 폴더에 google-client.json으로 두면 거기서 읽어요(ID가 없을 때만)
# GOOGLE_CLIENT_FILE=./google-client.json

# 프록시나 도메인 뒤에서 서버를 열 때만: 접속을 허용할 주소를 쉼표로 (기본은 서버 주소와 같은 곳만)
# ALLOWED_ORIGINS=https://example.com

# 서버 포트 (기본 3000)
# PORT=3000
